    titlePad: true,
    breadcrumbs: true,
    topPanel: true,
    footerPanel: true,
    useSitemapMetadata: true,
};

export type Page = {
    path: string;
    title: string;
    description?: string;

    options?: {};

    metadata?: {
        ogTitle?: string;
        ogImage?: string;
        ogType?: string;
        themeColor?: string;
    };

    children?: Page[];
};

export type IndexedSitePage = Omit<Page, "children" | "options"> & {
    options: PageOptions;
    parent?: IndexedSitePage;
};

